APP_NAME=Goravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# APP_KEY is required for session/cookie encryption. Generate a strong random value
# before deploying (e.g. `php artisan key:generate` equivalent). Do not leave empty.

LOG_CHANNEL=stack
LOG_LEVEL=debug

SESSION_DRIVER=file
SESSION_LIFETIME=120

APP_URL=http://localhost
APP_HOST=127.0.0.1
APP_PORT=4001

JWT_SECRET=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=immigra
DB_USERNAME=root
DB_PASSWORD=

MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# ADMIN_USERNAME and ADMIN_PASSWORD are required to access /admin.
# There are no insecure default fallbacks; these must be set.
ADMIN_USERNAME=
ADMIN_PASSWORD=
