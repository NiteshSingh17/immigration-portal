<style>
/* =========================================================
   OINP WORKFORCE PRIORITY EOI SCORE CALCULATOR
   FULL COPY-PASTE VERSION
   ========================================================= */

.oinp-calculator,
.oinp-calculator * {
    box-sizing: border-box;
}

.oinp-calculator {
    width: 100%;
    max-width: 1180px;
    margin: 40px auto;
    padding: 0 18px;
    font-family: Inter, Arial, Helvetica, sans-serif;
    color: #111;
}

.oinp-header {
    text-align: center;
    margin-bottom: 32px;
    animation: oinpFadeUp .6s ease both;
}

.oinp-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #e00000;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 12px;
}

.oinp-eyebrow:before,
.oinp-eyebrow:after {
    content: "";
    width: 24px;
    height: 2px;
    background: #e00000;
}

.oinp-header h1 {
    margin: 0;
    font-size: clamp(30px, 5vw, 52px);
    line-height: 1.08;
    font-weight: 900;
    letter-spacing: -1.5px;
}

.oinp-header h1 span {
    color: #e00000;
}

.oinp-header p {
    max-width: 850px;
    margin: 16px auto 0;
    color: #666;
    font-size: 16px;
    line-height: 1.7;
}


/* SCORE CARD */

.oinp-score-card {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 28px;
    align-items: center;
    padding: 28px;
    margin-bottom: 25px;
    border: 1px solid #e5e5e5;
    border-radius: 24px;
    box-shadow: 0 14px 45px rgba(0,0,0,.07);
    animation: oinpFadeUp .7s ease both;
}

.oinp-score-number {
    text-align: center;
    border: 2px solid #e00000;
    border-radius: 20px;
    padding: 25px 15px;
}

.oinp-score-value {
    font-size: 56px;
    line-height: 1;
    font-weight: 900;
    color: #e00000;
    transition: transform .25s ease;
}

.oinp-score-value.bump {
    transform: scale(1.08);
}

.oinp-score-label {
    margin-top: 10px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #555;
}

.oinp-score-info h2 {
    margin: 0 0 8px;
    font-size: 23px;
    font-weight: 850;
}

.oinp-score-info p {
    margin: 0;
    color: #666;
    font-size: 14px;
    line-height: 1.65;
}

.oinp-progress {
    margin-top: 20px;
}

.oinp-progress-top {
    display: flex;
    justify-content: space-between;
    margin-bottom: 8px;
    font-size: 12px;
    font-weight: 800;
    color: #555;
}

.oinp-progress-bar {
    width: 100%;
    height: 8px;
    border: 1px solid #ddd;
    border-radius: 50px;
    overflow: hidden;
}

.oinp-progress-fill {
    width: 0%;
    height: 100%;
    background: #e00000;
    border-radius: inherit;
    transition: width .5s cubic-bezier(.22,1,.36,1);
}


/* MAIN */

.oinp-main-grid {
    display: grid;
    grid-template-columns: minmax(0,1fr) 315px;
    gap: 25px;
    align-items: start;
}


/* SECTION */

.oinp-section {
    padding: 25px;
    margin-bottom: 20px;
    border: 1px solid #e7e7e7;
    border-radius: 20px;
    box-shadow: 0 8px 30px rgba(0,0,0,.045);
    animation: oinpFadeUp .7s ease both;
}

.oinp-section-header {
    display: flex;
    gap: 13px;
    align-items: flex-start;
    margin-bottom: 25px;
}

.oinp-section-icon {
    width: 43px;
    height: 43px;
    min-width: 43px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #f0b5b5;
    border-radius: 12px;
    color: #e00000;
    font-size: 13px;
    font-weight: 900;
}

.oinp-section-title h2 {
    margin: 0;
    font-size: 20px;
    line-height: 1.25;
    font-weight: 850;
}

.oinp-section-title p {
    margin: 5px 0 0;
    color: #777;
    font-size: 13px;
    line-height: 1.6;
}


/* QUESTIONS */

.oinp-question {
    margin-bottom: 24px;
}

.oinp-question:last-child {
    margin-bottom: 0;
}

.oinp-label-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 15px;
    margin-bottom: 9px;
}

.oinp-question label {
    display: block;
    color: #181818;
    font-size: 14px;
    line-height: 1.55;
    font-weight: 750;
}

.oinp-points {
    flex-shrink: 0;
    color: #e00000;
    font-size: 12px;
    font-weight: 850;
    opacity: 0;
    transform: translateY(3px);
    transition: .25s ease;
}

.oinp-points.show {
    opacity: 1;
    transform: translateY(0);
}


/* SELECT */

.oinp-select-wrap {
    position: relative;
}

.oinp-select {
    width: 100%;
    min-height: 53px;
    padding: 12px 45px 12px 15px;
    border: 1px solid #d9d9d9;
    border-radius: 12px;
    outline: none;
    background: transparent;
    color: #222;
    font-family: inherit;
    font-size: 14px;
    line-height: 1.45;
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
    transition: border-color .2s ease, box-shadow .2s ease;
}

.oinp-select:hover {
    border-color: #aaa;
}

.oinp-select:focus {
    border-color: #e00000;
    box-shadow: 0 0 0 4px rgba(224,0,0,.08);
}

.oinp-select:disabled {
    cursor: not-allowed;
    opacity: .45;
}

.oinp-select-wrap:after {
    content: "⌄";
    position: absolute;
    right: 17px;
    top: 50%;
    transform: translateY(-55%);
    pointer-events: none;
    color: #e00000;
    font-size: 20px;
    font-weight: 900;
}


/* NOTES */

.oinp-note {
    margin-top: 9px;
    padding: 10px 12px;
    border-left: 3px solid #e00000;
    color: #666;
    font-size: 12px;
    line-height: 1.7;
}

.oinp-note strong {
    color: #222;
}


/* CONDITIONAL EXPERIENCE */

.oinp-conditional {
    display: none;
    margin-top: 16px;
    padding: 17px;
    border: 1px dashed #e2a0a0;
    border-radius: 14px;
    animation: oinpFadeUp .35s ease both;
}

.oinp-conditional.visible {
    display: block;
}

.oinp-conditional-title {
    margin-bottom: 8px;
    color: #e00000;
    font-size: 13px;
    font-weight: 850;
}

.oinp-conditional-description {
    margin-bottom: 14px;
    color: #666;
    font-size: 12px;
    line-height: 1.65;
}


/* DISABLED QUESTION */

.oinp-question.disabled {
    opacity: .45;
}


/* SUMMARY */

.oinp-summary {
    position: sticky;
    top: 25px;
    padding: 24px;
    border: 1px solid #e7e7e7;
    border-radius: 20px;
    box-shadow: 0 8px 30px rgba(0,0,0,.05);
}

.oinp-summary h3 {
    margin: 0 0 18px;
    font-size: 18px;
    font-weight: 850;
}

.oinp-summary-row {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    padding: 13px 0;
    border-bottom: 1px solid #eee;
    font-size: 13px;
}

.oinp-summary-row span:first-child {
    color: #555;
}

.oinp-summary-row span:last-child {
    font-weight: 850;
}

.oinp-summary-total {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 15px;
    padding-top: 16px;
    border-top: 2px solid #111;
}

.oinp-summary-total span:first-child {
    font-size: 14px;
    font-weight: 850;
}

.oinp-summary-total span:last-child {
    color: #e00000;
    font-size: 25px;
    font-weight: 900;
}


/* RESET */

.oinp-reset {
    width: 100%;
    margin-top: 20px;
    padding: 13px 18px;
    border: 1px solid #111;
    border-radius: 11px;
    background: transparent;
    color: #111;
    font-family: inherit;
    font-size: 13px;
    font-weight: 800;
    cursor: pointer;
    transition: all .25s ease;
}

.oinp-reset:hover {
    background: #111;
    color: #fff;
    transform: translateY(-2px);
}


/* REGION DETAILS */

.oinp-region-details {
    margin-top: 16px;
    border: 1px solid #ececec;
    border-radius: 13px;
    overflow: hidden;
}

.oinp-region-details summary {
    padding: 13px 15px;
    cursor: pointer;
    list-style: none;
    font-size: 12px;
    font-weight: 800;
}

.oinp-region-details summary::-webkit-details-marker {
    display: none;
}

.oinp-region-details summary:after {
    content: "+";
    float: right;
    color: #e00000;
    font-size: 17px;
}

.oinp-region-details[open] summary:after {
    content: "−";
}

.oinp-region-content {
    padding: 0 15px 15px;
    border-top: 1px solid #eee;
}

.oinp-region-item {
    padding: 10px 0;
    border-bottom: 1px solid #eee;
    color: #666;
    font-size: 11.5px;
    line-height: 1.65;
}

.oinp-region-item:last-child {
    border-bottom: 0;
}

.oinp-region-item strong {
    color: #222;
}


/* DISCLAIMER */

.oinp-disclaimer {
    margin-top: 22px;
    padding: 19px;
    border-left: 4px solid #e00000;
    border-radius: 0 12px 12px 0;
    color: #5d5d5d;
    font-size: 12px;
    line-height: 1.8;
}

.oinp-disclaimer strong {
    color: #111;
}

.oinp-source {
    margin-top: 14px;
    padding-top: 13px;
    border-top: 1px solid #eee;
}


/* ANIMATION */

@keyframes oinpFadeUp {
    from {
        opacity: 0;
        transform: translateY(18px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}


/* TABLET */

@media (max-width: 900px) {

    .oinp-main-grid {
        grid-template-columns: 1fr;
    }

    .oinp-summary {
        position: static;
        order: -1;
    }

    .oinp-score-card {
        grid-template-columns: 180px 1fr;
    }
}


/* MOBILE */

@media (max-width: 650px) {

    .oinp-calculator {
        margin: 25px auto;
        padding: 0 12px;
    }

    .oinp-header h1 {
        font-size: 31px;
        letter-spacing: -.8px;
    }

    .oinp-header p {
        font-size: 14px;
    }

    .oinp-score-card {
        grid-template-columns: 1fr;
        gap: 18px;
        padding: 18px;
        border-radius: 18px;
    }

    .oinp-score-number {
        padding: 20px;
    }

    .oinp-score-value {
        font-size: 48px;
    }

    .oinp-section {
        padding: 18px;
        border-radius: 17px;
    }

    .oinp-section-title h2 {
        font-size: 18px;
    }

    .oinp-label-row {
        display: block;
    }

    .oinp-points {
        display: inline-block;
        margin-top: 5px;
    }

    .oinp-select {
        min-height: 55px;
        font-size: 13px;
    }

    .oinp-summary {
        padding: 18px;
    }
}

@media (max-width: 380px) {

    .oinp-header h1 {
        font-size: 27px;
    }

    .oinp-section {
        padding: 15px;
    }

    .oinp-select {
        font-size: 12px;
    }
}
</style>


