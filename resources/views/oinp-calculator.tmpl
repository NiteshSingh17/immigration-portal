<script>
(function () {

    "use strict";


    /* =====================================================
       BASIC ELEMENTS
       ===================================================== */

    const calculator =
        document.getElementById("oinpCalculator");

    if (!calculator) return;


    const applicantType =
        calculator.querySelector("#applicantType");

    const wageSelect =
        calculator.querySelector("#wage");

    const wageQuestion =
        calculator.querySelector("#wageQuestion");

    const jobExperience =
        calculator.querySelector("#jobExperience");

    const experienceLabel =
        calculator.querySelector("#experienceLabel");

    const experienceNote =
        calculator.querySelector("#jobExperienceNote");

    const ontarioExperience =
        calculator.querySelector("#ontarioExperience");

    const ontarioExperienceBox =
        calculator.querySelector("#ontarioExperienceBox");

    const totalScoreEl =
        calculator.querySelector("#oinpTotalScore");

    const progressFill =
        calculator.querySelector("#oinpProgressFill");

    const progressText =
        calculator.querySelector("#oinpProgressText");

    const resetButton =
        calculator.querySelector("#oinpReset");


    const MAX_SCORE = 130;


    /* =====================================================
       CATEGORY SCORES
       ===================================================== */

    let scores = {

        employment: 0,

        education: 0,

        language: 0,

        regionalization: 0

    };


    /* =====================================================
       POINT LABELS
       ===================================================== */

    const pointLabels = {

        teer: "points-teer",

        occupation: "points-occupation",

        wage: "points-wage",

        jobExperience: "points-jobExperience",

        ontarioExperience:
            "points-ontarioExperience",

        earnings: "points-earnings",

        status: "points-status",

        education: "points-education",

        credentials: "points-credentials",

        clb: "points-clb",

        languages: "points-languages",

        region: "points-region"

    };


    /* =====================================================
       EXPERIENCE OPTIONS
       
       IMPORTANT:
       Options are dynamically created.
       This fixes the previous dropdown problem.
       ===================================================== */

    function updateExperienceOptions() {

        const type =
            applicantType.value;


        /*
         * Completely clear existing options.
         */

        jobExperience.innerHTML = "";


        /*
         * Default option.
         */

        const defaultOption =
            document.createElement("option");

        defaultOption.value = "";

        defaultOption.dataset.score = "0";

        defaultOption.textContent =
            "Select experience";

        jobExperience.appendChild(
            defaultOption
        );


        /* ===============================================
           JOB OFFER APPLICANT
           =============================================== */

        if (type === "job") {

            const options = [

                {
                    score: 18,
                    text:
                        "Over 24 months working in job offer position — 18 points"
                },

                {
                    score: 15,
                    text:
                        "13 to 24 months working in job offer position — 15 points"
                },

                {
                    score: 12,
                    text:
                        "6 to 12 months working in job offer position — 12 points"
                },

                {
                    score: 0,
                    text:
                        "Less than 6 months working in job offer position or not currently working in position — 0 points"
                }

            ];


            options.forEach(function (item) {

                const option =
                    document.createElement("option");

                option.value =
                    String(item.score);

                option.dataset.score =
                    String(item.score);

                option.textContent =
                    item.text;

                jobExperience.appendChild(
                    option
                );

            });

        }


        /* ===============================================
           SELF-EMPLOYED PHYSICIAN
           =============================================== */

        else if (type === "physician") {

            const options = [

                {
                    score: 18,
                    text:
                        "Over 24 months cumulative medical practice in Ontario — 18 points"
                },

                {
                    score: 15,
                    text:
                        "13 months up to 24 months cumulative medical practice in Ontario — 15 points"
                },

                {
                    score: 12,
                    text:
                        "6 months up to 12 months cumulative medical practice in Ontario — 12 points"
                },

                {
                    score: 0,
                    text:
                        "Less than 6 months cumulative medical practice in Ontario — 0 points"
                }

            ];


            options.forEach(function (item) {

                const option =
                    document.createElement("option");

                option.value =
                    String(item.score);

                option.dataset.score =
                    String(item.score);

                option.textContent =
                    item.text;

                jobExperience.appendChild(
                    option
                );

            });

        }


        /* ===============================================
           NO APPLICANT TYPE SELECTED
           =============================================== */

        else {

            const options = [

                {
                    score: 18,
                    text:
                        "Over 24 months — 18 points"
                },

                {
                    score: 15,
                    text:
                        "13 to 24 months — 15 points"
                },

                {
                    score: 12,
                    text:
                        "6 to 12 months — 12 points"
                },

                {
                    score: 0,
                    text:
                        "Less than 6 months — 0 points"
                }

            ];


            options.forEach(function (item) {

                const option =
                    document.createElement("option");

                option.value =
                    String(item.score);

                option.dataset.score =
                    String(item.score);

                option.textContent =
                    item.text;

                jobExperience.appendChild(
                    option
                );

            });

        }

    }


    /* =====================================================
       UPDATE CONDITIONAL QUESTIONS
       ===================================================== */

    function updateConditionalQuestions() {

        const type =
            applicantType.value;


        /* ===============================================
           PHYSICIAN
           =============================================== */

        if (type === "physician") {

            /*
             * Disable wage for physician.
             */

            wageSelect.value = "";

            wageSelect.disabled = true;

            wageQuestion.classList.add(
                "disabled"
            );


            /*
             * Physician experience wording.
             */

            experienceLabel.textContent =
                "What is your cumulative medical practice history in Ontario?";


            experienceNote.textContent =
                "For self-employed physicians, select your cumulative qualifying medical practice history in Ontario.";


            /*
             * Hide Ontario work experience.
             */

            ontarioExperienceBox.classList.remove(
                "visible"
            );

            ontarioExperience.value = "";


            clearPoint(
                "ontarioExperience"
            );


            return;
        }


        /* ===============================================
           JOB OFFER
           =============================================== */

        if (type === "job") {

            /*
             * Enable wage.
             */

            wageSelect.disabled = false;

            wageQuestion.classList.remove(
                "disabled"
            );


            experienceLabel.textContent =
                "What is your work experience in the job offer position?";


            experienceNote.textContent =
                "For job-offer applicants, points are based on qualifying experience in the job-offer position. If you have less than 6 months in the position, qualifying Ontario work experience may apply.";


            /*
             * Check selected experience.
             */

            const selected =
                jobExperience.options[
                    jobExperience.selectedIndex
                ];


            const selectedText =
                selected
                    ? selected.textContent.toLowerCase()
                    : "";


            /*
             * Show Ontario experience only
             * for less-than-6-month option.
             */

            if (
                selectedText.includes(
                    "less than 6 months"
                )
            ) {

                ontarioExperienceBox.classList.add(
                    "visible"
                );

            } else {

                ontarioExperienceBox.classList.remove(
                    "visible"
                );

                ontarioExperience.value = "";

                clearPoint(
                    "ontarioExperience"
                );

            }


            return;
        }


        /* ===============================================
           NO APPLICANT TYPE
           =============================================== */

        /*
         * Wage remains clickable.
         */

        wageSelect.disabled = false;

        wageQuestion.classList.remove(
            "disabled"
        );


        experienceLabel.textContent =
            "What is your work experience in the job offer position?";


        experienceNote.textContent =
            "Select your applicant type to determine which experience options apply.";


        ontarioExperienceBox.classList.remove(
            "visible"
        );

    }


    /* =====================================================
       EXPERIENCE CHANGE
       ===================================================== */

    function updateExperienceVisibility() {

        const type =
            applicantType.value;


        if (type !== "job") {

            ontarioExperienceBox.classList.remove(
                "visible"
            );

            ontarioExperience.value = "";

            clearPoint(
                "ontarioExperience"
            );

            return;

        }


        const selected =
            jobExperience.options[
                jobExperience.selectedIndex
            ];


        if (!selected) return;


        const text =
            selected.textContent.toLowerCase();


        if (
            text.includes(
                "less than 6 months"
            )
        ) {

            ontarioExperienceBox.classList.add(
                "visible"
            );

        } else {

            ontarioExperienceBox.classList.remove(
                "visible"
            );

            ontarioExperience.value = "";

            clearPoint(
                "ontarioExperience"
            );

        }

    }


    /* =====================================================
       CLEAR POINT
       ===================================================== */

    function clearPoint(pointKey) {

        const id =
            pointLabels[pointKey];

        if (!id) return;


        const element =
            calculator.querySelector(
                "#" + id
            );

        if (!element) return;


        element.textContent = "";

        element.classList.remove(
            "show"
        );

    }


    /* =====================================================
       CALCULATE SCORE
       ===================================================== */

    function calculateScore() {

        scores = {

            employment: 0,

            education: 0,

            language: 0,

            regionalization: 0

        };


        const selects =
            calculator.querySelectorAll(
                ".score-select"
            );


        selects.forEach(function (select) {

            /*
             * Disabled wage for physician
             * should not count.
             */

            if (select.disabled) {
                return;
            }


            /*
             * Ontario experience only counts
             * when its box is visible.
             */

            if (
                select === ontarioExperience &&
                !ontarioExperienceBox.classList.contains(
                    "visible"
                )
            ) {

                return;

            }


            const selectedOption =
                select.options[
                    select.selectedIndex
                ];


            if (!selectedOption) {
                return;
            }


            const points =
                Number(
                    selectedOption.dataset.score || 0
                );


            const category =
                select.dataset.category;


            if (
                category &&
                Object.prototype.hasOwnProperty.call(
                    scores,
                    category
                )
            ) {

                scores[category] +=
                    points;

            }


            const pointKey =
                select.dataset.points;


            if (
                pointKey &&
                pointLabels[pointKey]
            ) {

                const pointElement =
                    calculator.querySelector(
                        "#" +
                        pointLabels[pointKey]
                    );


                if (!pointElement) {
                    return;
                }


                if (
                    select.value !== ""
                ) {

                    pointElement.textContent =
                        "+" + points + " pts";

                    pointElement.classList.add(
                        "show"
                    );

                } else {

                    pointElement.textContent =
                        "";

                    pointElement.classList.remove(
                        "show"
                    );

                }

            }

        });


        /*
         * Total
         */

        const total =
            scores.employment +
            scores.education +
            scores.language +
            scores.regionalization;


        updateScoreDisplay(
            total
        );

    }


    /* =====================================================
       SCORE DISPLAY
       ===================================================== */

    function updateScoreDisplay(total) {

        totalScoreEl.textContent =
            total;


        calculator.querySelector(
            "#sum-employment"
        ).textContent =
            scores.employment + " pts";


        calculator.querySelector(
            "#sum-education"
        ).textContent =
            scores.education + " pts";


        calculator.querySelector(
            "#sum-language"
        ).textContent =
            scores.language + " pts";


        calculator.querySelector(
            "#sum-regionalization"
        ).textContent =
            scores.regionalization + " pts";


        calculator.querySelector(
            "#sum-total"
        ).textContent =
            total + " pts";


        /*
         * Progress
         */

        const percentage =
            Math.min(
                (total / MAX_SCORE) * 100,
                100
            );


        progressFill.style.width =
            percentage + "%";


        progressText.textContent =
            total + " / " + MAX_SCORE;


        /*
         * Score animation
         */

        totalScoreEl.classList.remove(
            "bump"
        );

        void totalScoreEl.offsetWidth;

        totalScoreEl.classList.add(
            "bump"
        );

    }


    /* =====================================================
       APPLICANT TYPE CHANGE
       ===================================================== */

    applicantType.addEventListener(
        "change",
        function () {

            updateExperienceOptions();

            updateConditionalQuestions();

            updateExperienceVisibility();

            calculateScore();

        }
    );


    /* =====================================================
       EXPERIENCE CHANGE
       ===================================================== */

    jobExperience.addEventListener(
        "change",
        function () {

            updateConditionalQuestions();

            updateExperienceVisibility();

            calculateScore();

        }
    );


    /* =====================================================
       ALL SCORE SELECTS
       ===================================================== */

    calculator
        .querySelectorAll(
            ".score-select"
        )
        .forEach(function (select) {

            select.addEventListener(
                "change",
                function () {

                    /*
                     * Experience dropdown
                     * has its own logic.
                     */

                    if (
                        select === jobExperience
                    ) {

                        updateExperienceVisibility();

                    }

                    calculateScore();

                }
            );

        });


    /* =====================================================
       RESET
       ===================================================== */

    resetButton.addEventListener(
        "click",
        function () {

            /*
             * Reset every select.
             */

            calculator
                .querySelectorAll(
                    "select"
                )
                .forEach(function (select) {

                    select.value = "";

                });


            /*
             * Wage becomes clickable again.
             */

            wageSelect.disabled = false;

            wageQuestion.classList.remove(
                "disabled"
            );


            /*
             * Hide conditional box.
             */

            ontarioExperienceBox.classList.remove(
                "visible"
            );


            /*
             * Clear point labels.
             */

            calculator
                .querySelectorAll(
                    ".oinp-points"
                )
                .forEach(function (element) {

                    element.textContent = "";

                    element.classList.remove(
                        "show"
                    );

                });


            /*
             * Rebuild experience options.
             */

            updateExperienceOptions();

            updateConditionalQuestions();

            updateExperienceVisibility();

            calculateScore();

        }
    );


    /* =====================================================
       INITIAL LOAD
       ===================================================== */

    /*
     * Wage must initially be clickable.
     */

    wageSelect.disabled = false;

    wageQuestion.classList.remove(
        "disabled"
    );


    /*
     * Build experience dropdown.
     */

    updateExperienceOptions();


    /*
     * Apply initial conditional state.
     */

    updateConditionalQuestions();

    updateExperienceVisibility();


    /*
     * Initial score.
     */

    calculateScore();

})();
</script>


       



