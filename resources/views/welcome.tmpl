<script>
  document.getElementById('menuBtn')?.addEventListener('click', () => document.getElementById('mobileMenu')?.classList.toggle('hidden'));
  window.addEventListener('DOMContentLoaded', () => lucide?.createIcons());

  // Testimonials carousel
  const testimonialCarousel = document.getElementById('testimonialCarousel');
  const testimonialCards = testimonialCarousel?.querySelectorAll('.testimonial-card');

  function moveTestimonials(direction) {
    if (!testimonialCarousel || !testimonialCards?.length) return;
    const cardWidth = testimonialCards[0].getBoundingClientRect().width;
    const maxScroll = testimonialCarousel.scrollWidth - testimonialCarousel.clientWidth;
    const nextScroll = testimonialCarousel.scrollLeft + direction * (cardWidth + 20);
    testimonialCarousel.scrollTo({
      left: Math.max(0, Math.min(maxScroll, nextScroll)),
      behavior: 'smooth'
    });
  }

  document.getElementById('testimonialPrev')?.addEventListener('click', () => moveTestimonials(-1));
  document.getElementById('testimonialNext')?.addEventListener('click', () => moveTestimonials(1));
</script>
