            <footer class="mt-8 flex items-center gap-4 border-t border-ink/10 pt-6"><img class="h-11 w-11 rounded-full object-cover" src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=150&q=80" alt="Daniel K."><div><strong class="block text-sm">Daniel K.</strong><span class="text-xs text-ink/50">Study permit</span></div></footer>
          </article>
          <article class="testimonial-card snap-start rounded-sm bg-white p-7 shadow-[0_12px_40px_rgba(11,31,51,.06)] sm:p-9">
            <i data-lucide="quote" class="h-8 w-8 text-gold"></i>
