{{ define "privacy.tmpl" }}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Privacy Policy | Northway Immigration</title>
  <link rel="stylesheet" href="/public/css/app.css">
  <script defer src="https://unpkg.com/lucide@0.468.0/dist/umd/lucide.min.js"></script>
</head>
<body class="bg-white">
  <header class="border-b border-ink/10 bg-white"><nav class="container-page flex h-[78px] items-center justify-between"><a href="/" class="flex items-center gap-3"><div class="grid h-11 w-11 place-items-center rounded-full border-2 border-teal"><i data-lucide="compass" class="h-6 w-6 text-teal"></i></div><div><p class="font-serif text-[21px] font-bold leading-none">NORTHWAY</p><p class="mt-1 text-[9px] font-extrabold tracking-[0.28em] text-teal">IMMIGRATION</p></div></a><a class="text-sm font-bold text-teal" href="/">← Back to website</a></nav></header>
  <main class="bg-sand"><section class="bg-ink py-16 text-white"><div class="container-page"><p class="eyebrow !text-mint">Legal</p><h1 class="font-serif text-5xl font-bold">Privacy Policy</h1></div></section>
  <section class="container-page py-16"><article class="mx-auto max-w-3xl rounded-sm bg-white p-7 leading-7 text-ink/70 sm:p-12">
    <p class="text-sm">Last updated: November 22, 2026</p>
    <h2 class="mt-8 font-serif text-3xl font-bold text-ink">Information we collect</h2>
    <p class="mt-4">When you submit an enquiry, we may collect your name, email address, phone number, selected service and the information included in your message.</p>
    <h2 class="mt-8 font-serif text-3xl font-bold text-ink">How we use information</h2>
    <p class="mt-4">We use your information to respond to enquiries, provide immigration consultation information, and maintain appropriate records of your communication with us.</p>
    <h2 class="mt-8 font-serif text-3xl font-bold text-ink">Data storage</h2>
    <p class="mt-4">Enquiry information is stored securely in our database. Access is limited to authorised administrators.</p>
    <h2 class="mt-8 font-serif text-3xl font-bold text-ink">Information sharing</h2>
    <p class="mt-4">We do not sell or rent personal information. Information is shared only when necessary to respond to your request or when required by law.</p>
    <h2 class="mt-8 font-serif text-3xl font-bold text-ink">Your choices</h2>
    <p class="mt-4">You may contact us to request access, correction or deletion of personal information that you have provided.</p>
    <h2 class="mt-8 font-serif text-3xl font-bold text-ink">Contact us</h2>
    <p class="mt-4">For privacy questions, email <a class="font-bold text-teal" href="mailto:hello@northwayimmigration.ca">hello@northwayimmigration.ca</a>.</p>
  </article></section></main>
  <footer class="bg-ink py-8 text-center text-sm text-white/50">© 2026 Northway Immigration</footer>
  <script>window.addEventListener('DOMContentLoaded',()=>lucide?.createIcons())</script>
</body></html>{{ end }}
