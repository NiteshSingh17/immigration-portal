<style>
html,body{height:100%;margin:0;padding:0}
*{box-sizing:border-box}

/* Hide WP header/footer */
header, footer, .site-header, .site-footer, #masthead, #colophon { display:none !important; }

/* Page Background Green */

    
    

    body {
  font-family: "Poppins", sans-serif;
  background: #e62524 !important;
  display: flex;
  justify-content: center;
  align-items: flex-start;
  padding: 28px 16px;
}

/* Main Card */
.wrapper {
  width: 760px;
  max-width: calc(100% - 30px);
  margin: 0 auto 40px;
}

.card {
  background: #91b4d6;
  border-radius: 18px;
  padding: 32px;
  box-shadow: 0 0 30px rgba(0,0,0,0.3);
}

/* Buttons top */
.top-actions {
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:15px;
}
.action-btn{
  width:40px;height:40px;border-radius:50%;
  background:white;
  display:flex;justify-content:center;align-items:center;
  box-shadow:0 2px 6px rgba(0,0,0,0.20);
  cursor:pointer;
  font-size:18px;
}

/* PROFILE */
.profile{text-align:center;margin-bottom:20px;}
.avatar{
  width:130px;height:130px;border-radius:50%;
  margin:0 auto 12px;background:white;overflow:hidden;
  display:flex;align-items:center;justify-content:center;
  box-shadow:0 6px 15px rgba(0,0,0,0.15);
}
.avatar img{width:100%;height:100%;object-fit:cover;}

.profile h1{margin:0;font-size:20px;font-weight:600;}
.profile p{margin:8px auto;font-size:14px;color:#0d2c2d;line-height:1.5}

/* LINK ITEMS */
.links-wrap{
  margin-top:10px;
  overflow:visible !important; /* remove internal scrollbar */
}

.link-item{
  display:flex;
  align-items:center;
  gap:16px;
  background:white;
  border-radius:14px;
  padding:14px 16px;
  margin:12px 0;
  text-decoration:none;
  color:#000;
  transition:0.2s;
  box-shadow:0 5px 12px rgba(0,0,0,0.12);
}
.link-item:hover{ transform:scale(1.03); }

.link-icon{
  width:65px;
  height:65px;
  min-width:65px;
  border-radius:12px;
  background:white;
  display:flex;
  justify-content:center;
  align-items:center;
  overflow:hidden;
}

.link-icon img{
  width:100%;
  height:100%;
  object-fit:cover;
}

.link-icon i{
  font-size:34px;
}

.link-text{
  flex:1;
  font-size:17px;
  font-weight:600;
}

.link-more{
  font-size:20px;
  opacity:0.6;
}

/* Vibrate Animation for First Button */
@keyframes vibrate {
  0% { transform: translate(0); }
  20% { transform: translate(-2px, 2px); }
  40% { transform: translate(2px, -2px); }
  60% { transform: translate(-2px, -1px); }
  80% { transform: translate(1px, 1px); }
  100% { transform: translate(0); }
}

.vibrate {
  animation: vibrate 0.3s ease-in-out infinite;
  animation-delay: 2s;
}

/* RESPONSIVE */
@media (max-width:520px){
  .wrapper{width:100%;max-width:100%;}
  .avatar{width:110px;height:110px;}
  .link-icon{width:56px;height:56px;}
}
</style>

