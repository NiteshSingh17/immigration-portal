  z-index:2;
}

/* ===== BUTTONS ===== */

.cookie-buttons{
  display:flex;
  justify-content:center;
  gap:10px;
  flex-wrap:wrap;
  position:relative;
  z-index:2;
}

/* ===== COMMON BTN ===== */

.cookie-btn{
  border:none;
  padding:10px 18px;
  border-radius:40px;
  font-size:12px;
  font-weight:600;
  text-decoration:none;
