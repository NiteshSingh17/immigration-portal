<div id="work-permit-section" class="container py-5 mt-5" style="text-align:center;">
  <h3 style="color:#d80000; font-weight:700; margin-bottom:30px;">Work Permit – Things You Need To Know</h3>

  <div class="row g-4 justify-content-center">
    
    <!-- Who Can Apply -->
    <div class="col-md-4 col-lg-3 col-sm-6">
      <div class="visa-card p-3">
        <h5 class="fw-bold">Who Can Apply?</h5>
        <p style="font-size:14px; color:white;">
          ✔ Skilled workers with a valid job offer from a Canadian employer<br>
          ✔ International students graduating from a Canadian institution<br>
          ✔ Individuals eligible under international agreements or programs<br>
          ✔ Those meeting health and security requirements
        </p>
      </div>
    </div>

    <!-- Required Documents -->
    <div class="col-md-4 col-lg-3 col-sm-6">
      <div class="visa-card p-3">
        <h5 class="fw-bold">Required Documents</h5>
        <p style="font-size:14px; color:white;">
          ✔ Passport<br>
          ✔ Job offer letter & LMIA (if required)<br>
          ✔ Educational qualifications<br>
          ✔ Resume/CV<br>
          ✔ Proof of work experience<br>
          ✔ Police clearance certificate<br>
          ✔ Medical exam (if required)
        </p>
      </div>
    </div>

    <!-- Cost Involved -->
    <div class="col-md-4 col-lg-3 col-sm-6">
      <div class="visa-card p-3">
        <h5 class="fw-bold">How Much Does It Cost?</h5>
        <p style="font-size:14px; color:white;">
          ✔ Work Permit Application Fee: $155 CAD<br>
          ✔ Open Work Permit Fee (if applicable): $100 CAD<br>
          ✔ Biometrics Fee: $85 CAD<br>
          ✔ Medical Exam: $100–$300 CAD<br>
          ✔ LMIA Fee (employer, if required): varies
        </p>
      </div>
    </div>

    <!-- Other Requirements -->
    <div class="col-md-4 col-lg-3 col-sm-6">
      <div class="visa-card p-3">
        <h5 class="fw-bold">Other Requirements</h5>
        <p style="font-size:14px; color:white;">
          ✔ Valid job offer or eligibility under work programs<br>
          ✔ Relevant skills and experience for the job<br>
          ✔ Maintain legal status while in Canada<br>
          ✔ Comply with Canadian labor and immigration laws<br>
          ✔ No criminal record
        </p>
      </div>
    </div>

    <!-- Helpful Tips -->
    <div class="col-md-4 col-lg-3 col-sm-6">
      <div class="visa-card p-3">
        <h5 class="fw-bold">Helpful Tips</h5>
        <p style="font-size:14px; color:white;">
          ✔ Apply before current status expires<br>
          ✔ Keep all employment documents ready<br>
          ✔ Ensure employer follows LMIA or program rules<br>
          ✔ Maintain clear communication with immigration authorities<br>
          ✔ Update your address & contact info with IRCC
        </p>
      </div>
    </div>

  </div>
</div>

</section>

