<!-- ================= SCRIPT ================= -->
<script>
document.querySelectorAll('#work-permit-section .visa-card').forEach(card => {
  card.addEventListener('click', function() {
    document.querySelectorAll('#work-permit-section .visa-card')
      .forEach(c => c.classList.remove('active'));
    this.classList.add('active');
  });
});
</script>

       



