{{ define "admin/dashboard.tmpl" }}
<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Enquiries | Northway Admin</title><link rel="stylesheet" href="/public/css/app.css"><script defer src="https://unpkg.com/lucide@0.468.0/dist/umd/lucide.min.js"></script></head>
<body class="min-h-screen bg-[#f5f7f6] text-ink"><div class="flex min-h-screen"><aside class="fixed inset-y-0 left-0 hidden w-64 bg-ink p-6 text-white lg:block"><div class="flex items-center gap-3"><div class="grid h-10 w-10 place-items-center rounded-full border border-mint"><i data-lucide="compass" class="h-5 w-5 text-mint"></i></div><div><p class="font-serif font-bold">NORTHWAY</p><p class="text-[7px] tracking-[0.25em] text-mint">IMMIGRATION</p></div></div><nav class="mt-12"><a class="flex items-center gap-3 rounded-sm bg-white/10 px-4 py-3 text-sm font-bold text-mint" href="/admin"><i data-lucide="inbox" class="h-4 w-4"></i> Enquiries</a></nav><form method="POST" action="/admin/logout" class="absolute bottom-6 left-6 right-6"><button class="flex w-full items-center gap-3 px-4 py-3 text-sm text-white/60 hover:text-white"><i data-lucide="log-out" class="h-4 w-4"></i> Sign out</button></form></aside>
<main class="w-full lg:ml-64"><header class="flex h-20 items-center justify-between border-b border-ink/10 bg-white px-6 lg:px-10"><div><p class="text-xs font-bold text-teal">ADMINISTRATION</p><h1 class="mt-1 font-serif text-2xl font-bold">Enquiries</h1></div><div class="grid h-10 w-10 place-items-center rounded-full bg-mint font-bold text-teal">A</div></header>
<section class="p-6 lg:p-10"><div class="mb-6 grid gap-4 sm:grid-cols-3"><div class="rounded-sm bg-white p-5 shadow-sm"><p class="text-xs font-bold uppercase tracking-wider text-ink/50">Total enquiries</p><p class="mt-2 font-serif text-4xl font-bold">{{ .count }}</p></div><div class="rounded-sm bg-white p-5 shadow-sm"><p class="text-xs font-bold uppercase tracking-wider text-ink/50">New today</p><p class="mt-2 font-serif text-4xl font-bold">{{ .today }}</p></div><div class="rounded-sm bg-white p-5 shadow-sm"><p class="text-xs font-bold uppercase tracking-wider text-ink/50">Status</p><p class="mt-3 flex items-center gap-2 text-sm font-bold text-teal"><span class="h-2 w-2 rounded-full bg-teal"></span> Inbox active</p></div></div>
<div class="overflow-hidden rounded-sm bg-white shadow-sm"><div class="flex items-center justify-between border-b border-ink/10 px-5 py-4"><h2 class="font-bold">All enquiries</h2><span class="text-xs text-ink/50">Newest first</span></div><div class="overflow-x-auto"><table class="w-full text-left text-sm"><thead class="bg-[#fafbfa] text-xs uppercase tracking-wider text-ink/50"><tr><th class="px-5 py-4">Date</th><th class="px-5 py-4">Name</th><th class="px-5 py-4">Service</th><th class="px-5 py-4">Contact</th><th class="px-5 py-4">Message</th></tr></thead><tbody>{{ if .enquiries }}{{ range .enquiries }}<tr class="border-t border-ink/8 align-top"><td class="whitespace-nowrap px-5 py-5 text-ink/50">{{ .CreatedAt }}</td><td class="px-5 py-5 font-bold">{{ .Name }}</td><td class="px-5 py-5"><span class="rounded-full bg-mint px-3 py-1 text-xs font-bold text-teal">{{ .Service }}</span></td><td class="px-5 py-5"><a class="block font-medium" href="mailto:{{ .Email }}">{{ .Email }}</a><a class="mt-1 block text-ink/50" href="tel:{{ .Phone }}">{{ .Phone }}</a></td><td class="max-w-xs px-5 py-5 text-ink/65">{{ .Message }}</td></tr>{{ end }}{{ else }}<tr><td colspan="5" class="px-5 py-16 text-center text-ink/50">No enquiries have been submitted yet.</td></tr>{{ end }}</tbody></table></div></div></section></main></div><script>window.addEventListener('DOMContentLoaded',()=>lucide?.createIcons())</script></body></html>{{ end }}
