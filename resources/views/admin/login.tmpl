{{ define "admin/login.tmpl" }}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Admin Login | Northway Immigration</title>
  <link rel="stylesheet" href="/public/css/app.css">
  <script defer src="https://unpkg.com/lucide@0.468.0/dist/umd/lucide.min.js"></script>
</head>
<body class="min-h-screen bg-sand">
  <main class="grid min-h-screen lg:grid-cols-[1fr_480px]">
    <section class="hidden items-end bg-ink p-12 lg:flex"><div class="max-w-lg text-white"><p class="eyebrow !text-mint">Admin portal</p><h1 class="font-serif text-6xl font-bold">Northway Immigration</h1><p class="mt-5 text-white/65">Review and manage client enquiries securely.</p></div></section>
    <section class="flex items-center justify-center p-6"><div class="w-full max-w-sm"><a href="/" class="mb-10 flex items-center gap-3"><div class="grid h-11 w-11 place-items-center rounded-full border-2 border-teal"><i data-lucide="compass" class="h-6 w-6 text-teal"></i></div><div><p class="font-serif text-lg font-bold">NORTHWAY</p><p class="text-[8px] font-extrabold tracking-[0.25em] text-teal">IMMIGRATION</p></div></a><p class="eyebrow">Secure access</p><h2 class="font-serif text-4xl font-bold">Welcome back</h2><p class="mt-3 text-sm text-ink/60">Sign in to view website enquiries.</p>
      {{ if .error }}<div class="mt-6 rounded-sm border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">{{ .error }}</div>{{ end }}
      <form method="POST" action="/admin/login" class="mt-8 space-y-5"><div><label class="mb-2 block text-xs font-bold uppercase tracking-wider">Username</label><input name="username" required autocomplete="username" class="h-12 w-full rounded-sm border border-ink/15 bg-white px-4 outline-none focus:border-teal"></div><div><label class="mb-2 block text-xs font-bold uppercase tracking-wider">Password</label><input name="password" type="password" required autocomplete="current-password" class="h-12 w-full rounded-sm border border-ink/15 bg-white px-4 outline-none focus:border-teal"></div><button class="btn-primary w-full" type="submit">Sign in <i data-lucide="arrow-right" class="ml-2 h-4 w-4"></i></button></form>
    </div></section>
  </main>
  <script>window.addEventListener('DOMContentLoaded',()=>lucide?.createIcons())</script>
</body>
</html>{{ end }}
