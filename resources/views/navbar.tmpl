<!-- ✅ Topbar Animation -->
<style>
  .fade-in { animation: fadeInTopbar 0.8s ease forwards; }
  @keyframes fadeInTopbar { 0% { opacity: 0; transform: translateY(-20px); } 100% { opacity: 1; transform: translateY(0); } }
  .social-icon { display:inline-flex; align-items:center; justify-content:center; width:42px; height:42px; border:2px solid white; border-radius:50%; transition:all 0.3s ease; background:transparent; }
  .social-icon i { font-size:18px; color:black; transition:all 0.3s ease; }
  .social-icon:hover { background:white; }
  .social-icon:hover i { color:#dd302d; transform:scale(1.1); }
</style>

<script>
  window.addEventListener('load', () => {
    const spinner = document.getElementById('spinner');
    if (spinner) spinner.classList.remove('show');
    document.getElementById('topbar').style.opacity = 1;
  });
</script>

