<!-- ✅ Navbar CSS -->
<style>
/* Default Desktop Logo Size */
.navbar-logo {
  height: 55px;
  width: auto;
}

.mobile-flag {
  display: none;
}

/* 🔹 MOBILE VIEW */
@media (max-width: 991px) {
  .navbar {
    background: linear-gradient(135deg, #ffffff 70%, #fff0f0 100%);
    position: relative;
    text-align: center;
    border-bottom: 2px solid rgba(216, 0, 0, 0.1);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .navbar-brand {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    position: relative;
    gap: 4px;
  }

  .navbar-logo {
    height: 40px;
  }

  /* 🇨🇦 Flags visible only on mobile */
  .mobile-flag {
    display: inline-block;
    height: 30px;
    width: auto;
    opacity: 0.6;
    filter: saturate(110%) brightness(1.1);
    animation: gentle-wave 4s ease-in-out infinite alternate;
  }

  /* Menu icon aligned right */
  .navbar-toggler {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    border: none;
    background: none;
  }

  /* Gentle waving animation for flags */
  @keyframes gentle-wave {
    0% { transform: rotate(0deg) scale(1); }
    100% { transform: rotate(2deg) scale(1.05); }
  }
}

/* ✅ Navbar Extras (matches live site) */
.navbar-nav .nav-link { font-size:17px; font-weight:600; color:#000 !important; transition:color 0.2s ease; }
.navbar-nav .nav-link:hover { color:#d80000 !important; }
.custom-dropdown-toggle::after { content:"\25BC"; font-size:0.6rem; margin-left:6px; vertical-align:middle; transition:transform 0.2s ease; border:none!important; }
.show>.custom-dropdown-toggle::after { transform:rotate(180deg); }
.dropdown-menu { border-radius:8px; border:none; box-shadow:0 4px 10px rgba(0,0,0,0.1); }
.dropdown-item { color:#000; font-weight:500; transition:all 0.2s ease; }
.dropdown-item:hover { color:#d80000; background-color:#f8f9fa; }
.btn-custom:hover { background-color:#b30000; }
</style>

