}

/* ===== ACCEPT ===== */

document.getElementById("acceptCookie").onclick = function(){

  localStorage.setItem("cookieAccepted","true");

  document.getElementById("cookiePopup").style.display = "none";

}

/* ===== CLOSE ===== */

document.getElementById("closeCookie").onclick = function(){

  document.getElementById("cookiePopup").style.display = "none";

